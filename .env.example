# MongoDB Atlas connection string. Use a database user, not your Atlas account password.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/kakugodno?retryWrites=true&w=majority

# Use a random secret with at least 32 characters. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: a TURN relay service improves call connectivity behind restrictive NAT.
# Separate multiple TURN URLs with commas.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
